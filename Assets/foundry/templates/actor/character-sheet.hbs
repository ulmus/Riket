<form class="irt-sheet {{#if system.isNPC}}irt-npc{{/if}}" autocomplete="off">

  {{!-- Header --}}
  <header class="irt-header">
    <h1 class="irt-title">I Rikets Tjänst</h1>
    <div class="irt-subtitle">Program Frigg — Personakt</div>
  </header>

  {{!-- Character Info --}}
  <section class="irt-section irt-char-info">
    <h2 class="irt-section-title">Personakt</h2>
    <div class="irt-info-grid">
      <div class="irt-field">
        <label>Namn</label>
        <input type="text" name="name" value="{{actor.name}}" placeholder="Kodnamn / Riktigt namn" />
      </div>
      <div class="irt-field">
        <label>Expertis</label>
        <input type="text" name="system.expertis" value="{{system.expertis}}" placeholder="T.ex. Soldat, Spion, Läkare" />
      </div>
      <div class="irt-field">
        <label>Trauma</label>
        <select name="system.trauma.type">
          <option value="">—</option>
          {{#each traumaTypes}}
          <option value="{{this}}" {{#if (eq this ../system.trauma.type)}}selected{{/if}}>
            {{lookup (lookup @root "IRT.TraumaTypes") this}}{{!-- fallback --}}
            {{#if (eq this "forlust")}}Förlust{{/if}}
            {{#if (eq this "vanmakt")}}Vanmakt{{/if}}
            {{#if (eq this "skuld")}}Skuld{{/if}}
            {{#if (eq this "svek")}}Svek{{/if}}
            {{#if (eq this "skam")}}Skam{{/if}}
          </option>
          {{/each}}
        </select>
      </div>
      <div class="irt-field">
        <label>
          <input type="checkbox" name="system.isNPC" class="irt-npc-toggle" {{#if system.isNPC}}checked{{/if}} /> SLP-karaktär
        </label>
      </div>
      <div class="irt-field irt-field--wide">
        <label>Traumabeskrivning</label>
        <textarea name="system.trauma.description" placeholder="Beskriv händelsen som format din karaktär...">{{system.trauma.description}}</textarea>
      </div>
    </div>
  </section>

  {{!-- Attributes --}}
  <section class="irt-section irt-attributes">
    <h2 class="irt-section-title">Egenskaper</h2>
    <div class="irt-attr-grid">
      {{#each attributeKeys}}
      <div class="irt-attr-box">
        <label class="irt-attr-name">
          {{#if (eq this "analys")}}Analys{{/if}}
          {{#if (eq this "fysik")}}Fysik{{/if}}
          {{#if (eq this "list")}}List{{/if}}
          {{#if (eq this "samspel")}}Samspel{{/if}}
          {{#if (eq this "sinnen")}}Sinnen{{/if}}
          {{#if (eq this "smidighet")}}Smidighet{{/if}}
          {{#if (eq this "strid")}}Strid{{/if}}
          {{#if (eq this "vilja")}}Vilja{{/if}}
        </label>
        <input type="number" name="system.attributes.{{this}}" value="{{lookup ../system.attributes this}}" min="1" max="5" />
        <button type="button" class="irt-attr-roll" data-attr="{{this}}" title="Slå {{this}} + {{this}}">
          <i class="fas fa-dice-d20"></i>
        </button>
      </div>
      {{/each}}
    </div>
  </section>

  {{!-- Custom Roll --}}
  <section class="irt-section irt-custom-roll-section">
    <h2 class="irt-section-title">Egenskapsslag</h2>
    <div class="irt-custom-roll-form">
      <div class="irt-field">
        <label>Egenskap 1</label>
        <select name="customAttr1">
          {{#each attributeKeys}}
          <option value="{{this}}">
            {{#if (eq this "analys")}}Analys{{/if}}
            {{#if (eq this "fysik")}}Fysik{{/if}}
            {{#if (eq this "list")}}List{{/if}}
            {{#if (eq this "samspel")}}Samspel{{/if}}
            {{#if (eq this "sinnen")}}Sinnen{{/if}}
            {{#if (eq this "smidighet")}}Smidighet{{/if}}
            {{#if (eq this "strid")}}Strid{{/if}}
            {{#if (eq this "vilja")}}Vilja{{/if}}
          </option>
          {{/each}}
        </select>
      </div>
      <div class="irt-field">
        <label>Egenskap 2</label>
        <select name="customAttr2">
          {{#each attributeKeys}}
          <option value="{{this}}">
            {{#if (eq this "analys")}}Analys{{/if}}
            {{#if (eq this "fysik")}}Fysik{{/if}}
            {{#if (eq this "list")}}List{{/if}}
            {{#if (eq this "samspel")}}Samspel{{/if}}
            {{#if (eq this "sinnen")}}Sinnen{{/if}}
            {{#if (eq this "smidighet")}}Smidighet{{/if}}
            {{#if (eq this "strid")}}Strid{{/if}}
            {{#if (eq this "vilja")}}Vilja{{/if}}
          </option>
          {{/each}}
        </select>
      </div>
      <div class="irt-field">
        <label>Mod</label>
        <input type="number" name="customMod" value="0" />
      </div>
      <div class="irt-field">
        <label>Svårighet</label>
        <select name="customDifficulty">
          <option value="1">Normalt (1)</option>
          <option value="2">Svårt (2)</option>
          <option value="3">Mycket Svårt (3)</option>
        </select>
      </div>
      <button type="button" class="irt-custom-roll irt-btn">Slå</button>
    </div>
  </section>

  {{!-- Secondary Stats --}}
  <section class="irt-section irt-secondary">
    <h2 class="irt-section-title">Sekundära Egenskaper</h2>
    <div class="irt-secondary-grid">
      <div class="irt-secondary-stat">
        <label>KP</label>
        <div class="irt-stat-display">
          <input type="number" name="system.kp.value" value="{{system.kp.value}}" class="irt-current" />
          <span class="irt-sep">/</span>
          <span class="irt-max">{{system.kp.max}}</span>
        </div>
      </div>
      <div class="irt-secondary-stat">
        <label>Tålighet</label>
        <span class="irt-derived-val">{{system.derived.talighet}}</span>
      </div>
      <div class="irt-secondary-stat">
        <label>Stabilitet</label>
        <span class="irt-derived-val">{{system.derived.stabilitet}}</span>
      </div>
      <div class="irt-secondary-stat">
        <label>Förflyttning</label>
        <span class="irt-derived-val">{{system.derived.forflyttning}} m</span>
      </div>
      <div class="irt-secondary-stat">
        <label>Slagstyrka</label>
        <span class="irt-derived-val">{{system.derived.slagstyrka}}</span>
      </div>
    </div>
  </section>

  {{!-- Resources --}}
  <section class="irt-section irt-resources">
    <h2 class="irt-section-title">Resurser</h2>
    <div class="irt-resources-grid">
      <div class="irt-resource">
        <label>Fokus</label>
        <input type="number" name="system.fokus.value" value="{{system.fokus.value}}" min="0" class="irt-resource-input" />
        <span class="irt-resource-note">Momentum: {{system.fokus.momentum}}</span>
      </div>
      <div class="irt-resource irt-resource--stress">
        <label>Stress</label>
        <input type="number" name="system.stress.value" value="{{system.stress.value}}" min="0" class="irt-resource-input" />
        <span class="irt-resource-note">Sammanbrott vid &gt; {{system.derived.stabilitet}}</span>
      </div>
      <div class="irt-resource">
        <label>Momentum</label>
        <input type="number" name="system.fokus.momentum" value="{{system.fokus.momentum}}" min="1" max="5" class="irt-resource-input irt-resource-input--small" />
      </div>
    </div>
  </section>

  {{!-- Damage Status --}}
  <section class="irt-section irt-damage-status">
    <h2 class="irt-section-title">Skadenivå</h2>
    <div class="irt-conditions-grid">
      <label class="irt-condition">
        <input type="radio" name="system.skadeniva" value="oskadd" {{#if (eq system.skadeniva "oskadd")}}checked{{/if}} />
        Oskadd
      </label>
      <label class="irt-condition irt-condition--warning">
        <input type="radio" name="system.skadeniva" value="sarad" {{#if (eq system.skadeniva "sarad")}}checked{{/if}} />
        Sårad (+1 svårighet)
      </label>
      <label class="irt-condition irt-condition--danger">
        <input type="radio" name="system.skadeniva" value="medvetslos" {{#if (eq system.skadeniva "medvetslos")}}checked{{/if}} />
        Medvetslös
      </label>
      <label class="irt-condition irt-condition--critical">
        <input type="radio" name="system.skadeniva" value="doende" {{#if (eq system.skadeniva "doende")}}checked{{/if}} />
        Döende
      </label>
      <label class="irt-condition irt-condition--dead">
        <input type="radio" name="system.skadeniva" value="dod" {{#if (eq system.skadeniva "dod")}}checked{{/if}} />
        Död
      </label>
    </div>
    <div class="irt-blodning-row">
      <label>Blödning:</label>
      <select name="system.blodning">
        <option value="ingen" {{#if (eq system.blodning "ingen")}}selected{{/if}}>Ingen</option>
        <option value="latt" {{#if (eq system.blodning "latt")}}selected{{/if}}>Lätt</option>
        <option value="kraftig" {{#if (eq system.blodning "kraftig")}}selected{{/if}}>Kraftig</option>
      </select>
    </div>
    <div class="irt-field">
      <label>Kritiska effekter</label>
      <textarea name="system.kritiska_effekter" placeholder="Aktiva kritiska träff-effekter...">{{system.kritiska_effekter}}</textarea>
    </div>
  </section>

  {{!-- Weapons --}}
  <section class="irt-section irt-weapons">
    <h2 class="irt-section-title">Vapen</h2>
    {{#each weapons}}
    <div class="irt-item-row" data-item-id="{{this._id}}">
      <input type="text" class="irt-item-input" data-field="name" value="{{this.name}}" placeholder="Vapennamn" />
      <select class="irt-item-input" data-field="attackAttr">
        <option value="fysik" {{#if (eq this.system.attackAttr "fysik")}}selected{{/if}}>Fysik</option>
        <option value="smidighet" {{#if (eq this.system.attackAttr "smidighet")}}selected{{/if}}>Smidighet</option>
      </select>
      <input type="number" class="irt-item-input irt-item-num" data-field="damage" value="{{this.system.damage}}" title="Skada" />
      <input type="number" class="irt-item-input irt-item-num" data-field="range" value="{{this.system.range}}" title="Räckvidd (m)" />
      <select class="irt-item-input" data-field="damageType">
        {{#each ../damageTypes}}
        <option value="{{this}}" {{#if (eq this ../this.system.damageType)}}selected{{/if}}>
          {{#if (eq this "kross")}}Kross{{/if}}
          {{#if (eq this "stick")}}Stick{{/if}}
          {{#if (eq this "hugg")}}Hugg{{/if}}
          {{#if (eq this "eld")}}Eld{{/if}}
          {{#if (eq this "skjutvapen")}}Skjutvapen{{/if}}
          {{#if (eq this "explosion")}}Explosion{{/if}}
          {{#if (eq this "gift")}}Gift{{/if}}
          {{#if (eq this "blodning")}}Blödning{{/if}}
          {{#if (eq this "stralning")}}Strålning{{/if}}
          {{#if (eq this "ovriga")}}Övriga{{/if}}
        </option>
        {{/each}}
      </select>
      <input type="text" class="irt-item-input" data-field="properties" value="{{this.system.properties}}" placeholder="Egenskaper" />
      <button type="button" class="irt-weapon-attack irt-btn irt-btn--sm" title="Attackslag">Träffa</button>
      <button type="button" class="irt-weapon-damage irt-btn irt-btn--sm" title="Skadeslag">Skada</button>
      <button type="button" class="irt-item-delete irt-btn-icon" title="Ta bort"><i class="fas fa-trash"></i></button>
    </div>
    {{/each}}
    <button type="button" class="irt-item-create irt-btn" data-type="weapon"><i class="fas fa-plus"></i> Lägg till vapen</button>
  </section>

  {{!-- Armor --}}
  <section class="irt-section irt-armor">
    <h2 class="irt-section-title">Skydd</h2>
    <div class="irt-armor-row">
      <div class="irt-field">
        <label>Rustning/Skydd</label>
        <input type="text" name="system.skydd.name" value="{{system.skydd.name}}" placeholder="Typ av skydd" />
      </div>
      <div class="irt-field">
        <label>Skyddsvärde</label>
        <input type="number" name="system.skydd.value" value="{{system.skydd.value}}" min="0" />
      </div>
    </div>
  </section>

  {{!-- Powers --}}
  <section class="irt-section irt-powers irt-collapsible {{#if system.isNPC}}collapsed{{/if}}">
    <h2 class="irt-section-title irt-collapse-toggle">Krafter <span class="irt-collapse-icon">&#9660;</span></h2>
    <div class="irt-collapsible-content">
      {{#each powers}}
      <div class="irt-item-row irt-power-row" data-item-id="{{this._id}}">
        <input type="text" class="irt-item-input" data-field="name" value="{{this.name}}" placeholder="Kraftens namn" />
        <div class="irt-power-cost">
          <label>Fokus:</label>
          <input type="number" class="irt-item-input irt-item-num" data-field="fokusCost" value="{{this.system.fokusCost}}" min="0" />
        </div>
        <textarea class="irt-item-input" data-field="description" placeholder="Beskrivning och effekt...">{{this.system.description}}</textarea>
        <button type="button" class="irt-item-delete irt-btn-icon" title="Ta bort"><i class="fas fa-trash"></i></button>
      </div>
      {{/each}}
      <button type="button" class="irt-item-create irt-btn" data-type="power"><i class="fas fa-plus"></i> Lägg till kraft</button>
    </div>
  </section>

  {{!-- Abilities --}}
  <section class="irt-section irt-abilities irt-collapsible {{#if system.isNPC}}collapsed{{/if}}">
    <h2 class="irt-section-title irt-collapse-toggle">Förmågor <span class="irt-collapse-icon">&#9660;</span></h2>
    <div class="irt-collapsible-content">
      {{#each abilities}}
      <div class="irt-item-row irt-ability-row" data-item-id="{{this._id}}">
        <input type="text" class="irt-item-input" data-field="name" value="{{this.name}}" placeholder="Förmågans namn" />
        <input type="text" class="irt-item-input" data-field="requirements" value="{{this.system.requirements}}" placeholder="Krav" />
        <textarea class="irt-item-input" data-field="description" placeholder="Beskrivning och effekt...">{{this.system.description}}</textarea>
        <button type="button" class="irt-item-delete irt-btn-icon" title="Ta bort"><i class="fas fa-trash"></i></button>
      </div>
      {{/each}}
      <button type="button" class="irt-item-create irt-btn" data-type="ability"><i class="fas fa-plus"></i> Lägg till förmåga</button>
    </div>
  </section>

  {{!-- Equipment, Languages, Notes --}}
  <section class="irt-section irt-misc irt-collapsible {{#if system.isNPC}}collapsed{{/if}}">
    <h2 class="irt-section-title irt-collapse-toggle">Utrustning &amp; Anteckningar <span class="irt-collapse-icon">&#9660;</span></h2>
    <div class="irt-collapsible-content">
      <div class="irt-field">
        <label>Utrustning</label>
        <textarea name="system.equipment" placeholder="Lista din utrustning här...">{{system.equipment}}</textarea>
      </div>
      <div class="irt-field">
        <label>Språk <span class="irt-note">(antal = Analys)</span></label>
        <textarea name="system.languages" placeholder="Lista dina språk här (modersmål först)...">{{system.languages}}</textarea>
      </div>
      <div class="irt-field">
        <label>Anteckningar</label>
        <textarea name="system.notes" rows="6" placeholder="Bakgrund, kontakter, mål och andra anteckningar...">{{system.notes}}</textarea>
      </div>
    </div>
  </section>

  {{!-- XP --}}
  <section class="irt-section irt-xp irt-collapsible {{#if system.isNPC}}collapsed{{/if}}">
    <h2 class="irt-section-title irt-collapse-toggle">Erfarenhet <span class="irt-collapse-icon">&#9660;</span></h2>
    <div class="irt-collapsible-content">
      <div class="irt-xp-row">
        <div class="irt-field">
          <label>EP</label>
          <input type="number" name="system.xp" value="{{system.xp}}" min="0" class="irt-xp-input" />
        </div>
        <div class="irt-xp-costs">
          <p><strong>EP-kostnader:</strong></p>
          <ul>
            <li>Öka egenskap: 5 EP</li>
            <li>Ny förmåga: 2 EP</li>
            <li>Ny expertis: 7 EP</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

</form>
